# Example only; provision TLS privately and review existing alternate-origin transfers.
server {
    listen 80;
    server_name pantriportal.com www.pantriportal.com;
    return 301 https://www.pantriportal.com$request_uri;
}
server {
    listen 443 ssl;
    server_name www.pantriportal.com;
    ssl_certificate /etc/letsencrypt/live/www.pantriportal.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/www.pantriportal.com/privkey.pem;
    root /opt/pantry-portal/current;
    client_max_body_size 8m;
    location = / { try_files /index.html =404; }
    location = /admin.css { try_files $uri =404; }
    location = /admin.js { try_files $uri =404; }
    location = /app.js { try_files $uri =404; }
    location = /bootstrap.js { try_files $uri =404; }
    location = /favicon.ico { try_files $uri =404; }
    location = /features.css { try_files $uri =404; }
    location = /features.js { try_files $uri =404; }
    location = /home-sections.js { try_files $uri =404; }
    location = /index.html { try_files $uri =404; }
    location = /kitchen.css { try_files $uri =404; }
    location = /prescription-label.js { try_files $uri =404; }
    location = /prescription-scan.js { try_files $uri =404; }
    location = /medicine-benefits.js { try_files $uri =404; }
    location = /medicine.js { try_files $uri =404; }
    location = /navigation.js { try_files $uri =404; }
    location = /kitchen.js { try_files $uri =404; }
    location = /manifest.webmanifest { try_files $uri =404; }
    location = /migration.js { try_files $uri =404; }
    location = /mode-data.js { try_files $uri =404; }
    location = /modes.js { try_files $uri =404; }
    location = /pantriportal.css { try_files $uri =404; }
    location = /product-placeholder.svg { try_files $uri =404; }
    location = /sw.js { try_files $uri =404; }
    location = /vendor/tesseract.min.js { try_files $uri =404; }
    location = /vendor/zxing-browser.min.js { try_files $uri =404; }
    location = /web-assets/assets/cheesy-spinach-omelet.jpg { try_files $uri =404; }
    location = /web-assets/assets/creamy-chicken-pasta.png { try_files $uri =404; }
    location = /web-assets/assets/grim-recipe-transparent.png { try_files $uri =404; }
    location = /web-assets/assets/header-logo-dashboard.png { try_files $uri =404; }
    location = /web-assets/assets/pea-cheese-pasta.jpg { try_files $uri =404; }
    location = /web-assets/assets/recipe-dish-default.svg { try_files $uri =404; }
    location = /web-assets/assets/spinach-egg-bake.jpg { try_files $uri =404; }
    location = /web-assets/assets/tomato-black-bean-skillet.jpg { try_files $uri =404; }
    location = /web-assets/assets/tomato-spinach-pasta.png { try_files $uri =404; }
    location ^~ /web-assets/assets/ { try_files $uri =404; }
    location ^~ /models/Xenova/clip-vit-base-patch32/ { try_files $uri =404; }
    location = /api/recipes/parse-export {
        client_max_body_size 24m;
        proxy_pass http://127.0.0.1:8767;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location ^~ /api/ {
        proxy_pass http://127.0.0.1:8767;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location ^~ /media/ { proxy_pass http://127.0.0.1:8767; }
    location ^~ /migration/ { proxy_pass http://127.0.0.1:8766; }
    location / { return 404; }
}
